# gcloud CLI: PATH + completions, wherever it's installed (Homebrew, asdf, or the manual installer)
for _gcloud_sdk in \
  /opt/homebrew/share/google-cloud-sdk \
  /usr/local/share/google-cloud-sdk \
  $HOME/.asdf/installs/gcloud/*/google-cloud-sdk(Nn[-1]) \
  $HOME/google-cloud-sdk \
; do
  if [[ -d "$_gcloud_sdk" ]]; then
    export PATH="$PATH:$_gcloud_sdk/bin"
    [[ -f "$_gcloud_sdk/completion.zsh.inc" ]] && source "$_gcloud_sdk/completion.zsh.inc"
    break
  fi
done
unset _gcloud_sdk

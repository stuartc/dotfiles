# Global gitignore patterns for all repositories
# This file is managed by chezmoi

# Context symlinks into the central context repo — git-ignored everywhere.
# Telescope visibility is handled per-repo via a .ignore file containing !.context.
.context

# Per-repo re-include helpers for fd/ripgrep (e.g. !.context) — don't show in git status.
.ignore

# Claude
#
# Can be overridden in individual repos with !.claude/handoffs/ in repo .gitignore
# Or force-add specific files with: git add -f .claude/handoffs/file
.claude/handoffs/
**/.claude/settings.local.json


font-family = "FiraCode Nerd Font Mono Ret"
cursor-style = block
# ssh-terminfo installs xterm-ghostty on a host the first time you connect
# (cached per user@host, falls back to xterm-256color if `tic` is missing), so
# `tmux a` works on boxes that don't run this zshrc. Only wraps ssh from an
# interactive shell — not git/rsync/scp, and it conflicts with RemoteCommand.
shell-integration-features = no-cursor,ssh-env,ssh-terminfo
theme = "Github Dark Dimmed"
font-size = 14

unfocused-split-opacity = 1
macos-option-as-alt = true
window-padding-x = 4

keybind = alt+enter=text:\x1b[13;3u

# F17–F19 (Keychron Q1 Pro: right-cmd, fn+pgup, fn+pgdn). Emit fixed escape
# sequences so tmux user-keys match the same bytes in both terminals. F13–F16
# are skipped because macOS hijacks F14/F15 at the HID layer for brightness.
keybind = f17=text:\x1b[31~
keybind = f18=text:\x1b[32~
keybind = f19=text:\x1b[33~

mouse-hide-while-typing
clipboard-read = allow

# Cmd+Opt+Arrow → tmux pane switching (sends prefix C-Space + hjkl)
keybind = super+alt+left=text:\x00h
keybind = super+alt+right=text:\x00l
keybind = super+alt+up=text:\x00k
keybind = super+alt+down=text:\x00j

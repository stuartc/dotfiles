# Fix readability for dark terminal themes (Tokyo Night)
# Tig defaults use colored backgrounds (green cursor, blue titles) that are
# unreadable against this palette. Override everything to use colored TEXT on
# default backgrounds, apart from the cursor and the title bars.
#
# Tig has no hex colors. Named colors resolve to the terminal's ANSI palette,
# so they track Tokyo Night on their own; color 8 is bright black (#414868).
# The 256-color grayscale ramp is not remapped by a terminal theme, so its
# neutral greys read muddy against this blue-tinted background — 235 is the
# one background still drawn from it.

# Cursor/selection — dim bg, keeps per-element text colors
color cursor           default  8
color cursor-blur      default  235

# Title bars (tig default: white on blue)
color title-focus      black    blue  bold
color title-blur       default  8

# Status bar at bottom (tig default: white on green)
color status           black    blue

# Status view sections (tig default: green bg on headers)
color status.header    yellow   default  bold
color status.section   cyan     default

# Help view
color help.header      yellow   default  bold
color help.section     cyan     default

# Main view ref labels
color main-head        magenta  default  bold
color main-tag         yellow   default  bold
color main-local-tag   yellow   default
color main-remote      cyan     default
color main-tracked     blue     default  bold
color main-ref         green    default

# Diff
color diff-header      yellow   default
color diff-index       blue     default
color diff-chunk       magenta  default
color diff-stat        blue     default

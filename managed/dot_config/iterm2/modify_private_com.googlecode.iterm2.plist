#!/usr/bin/env python3
"""
chezmoi modify script for iTerm2 preferences.
Reads existing plist from stdin, updates managed settings, outputs to stdout.

This script only manages specific settings, preserving all other iTerm2
configuration (GUIDs, volatile state, custom color presets, etc.)
"""
import io
import os
import plistlib
import subprocess
import sys
import tempfile


# =============================================================================
# MANAGED SETTINGS - Only these settings will be enforced by chezmoi
# =============================================================================

# AI Configuration (iTerm2's AI features)
AI_SETTINGS = {
    "AIFeatureFunctionCalling": True,
    "AIFeatureHostedCodeInterpeter": False,  # Note: iTerm2's typo, not ours
    "AIFeatureHostedFileSearch": False,
    "AIFeatureHostedWebSearch": False,
    "AIFeatureStreamingResponses": True,
    "AITermAPI": 7,
    "AIVectorStore": 0,
    "AiMaxTokens": 200000,
    "AiModel": "claude-opus-4-8",
    "AiResponseMaxTokens": 128000,
    "AitermURL": "https://api.anthropic.com/v1/messages",
}

# Global behavior settings
GLOBAL_SETTINGS = {
    "AllowClipboardAccess": True,  # Allow apps to read clipboard
    "AlternateMouseScroll": True,  # Use scroll in vim/less without tmux
    "HapticFeedbackForEsc": False,
    "HideScrollbar": False,
    "LeftOption": 2,  # Left Option sends Esc+ (for Alt-key bindings)
    "TabStyleWithAutomaticOption": 5,  # Minimal tab style
    "TabViewType": 1,  # Tab bar position: 0=top, 1=bottom, 2=left
    "TerminalMargin": 5,  # Horizontal margin
    "TerminalVMargin": 0,  # Vertical margin
    "UseLionStyleFullscreen": False,  # Disable macOS native full-screen windows
}

# Global key bindings (GlobalKeyMap) — apply across all profiles, mirroring the
# equivalent Ghostty keybinds so tmux sees identical bytes in both terminals.
#   Action 10 = Send Escape Sequence (iTerm2 prepends ESC to Text)
#   Action 11 = Send Hex Codes (Text is space-separated hex bytes)
# Key format: char-modifiers-keyCode. Modifiers: 0x20000 = Shift; 0x380000 =
# Cmd+Opt + the numeric-pad flag (0x200000) that arrow keys always carry.
GLOBAL_KEYMAP = {
    # Shift+Enter -> CSI-u Shift+Enter (\e[13;2u). Deliberately NOT a bare LF:
    # a literal \n is Ctrl+J, which the smart-splits `bind -n C-j` in tmux.conf
    # would swallow (moving the pane down) instead of letting Claude Code insert
    # a newline. \e[13;2u is the exact byte sequence Ghostty emits natively via
    # CSI-u, tmux forwards it untouched, and Claude reads it as Shift+Enter.
    "0xd-0x20000-0x24": {
        "Action": 10, "Apply Mode": 0, "Escaping": 2, "Text": "[13;2u", "Version": 2,
    },
    # Cmd+Opt+Arrow -> tmux prefix (NUL = C-Space) + hjkl = seamless pane nav.
    # Mirror of Ghostty `super+alt+arrow=text:\x00<hjkl>`. Cmd/Super can't be
    # encoded by CSI-u and tmux doesn't speak the Kitty protocol, so this
    # translation has to live terminal-side rather than as a tmux binding.
    "0xf700-0x380000-0x7e": {  # Up -> prefix + k
        "Action": 11, "Apply Mode": 0, "Escaping": 2, "Text": "0x00 0x6b", "Version": 2,
    },
    "0xf701-0x380000-0x7d": {  # Down -> prefix + j
        "Action": 11, "Apply Mode": 0, "Escaping": 2, "Text": "0x00 0x6a", "Version": 2,
    },
    "0xf702-0x380000-0x7b": {  # Left -> prefix + h
        "Action": 11, "Apply Mode": 0, "Escaping": 2, "Text": "0x00 0x68", "Version": 2,
    },
    "0xf703-0x380000-0x7c": {  # Right -> prefix + l
        "Action": 11, "Apply Mode": 0, "Escaping": 2, "Text": "0x00 0x6c", "Version": 2,
    },
    # Cmd+Opt+[ / ] -> CSI 40~ / 41~ (tmux User3/User4 = shuffle window left/right).
    # Intercepts the chord before "Option sends Esc+" mangles it into a bare ESC[
    # / ESC] (CSI/OSC introducers, unbindable). Action 10 prepends ESC to Text;
    # mods 0x180000 = Cmd+Opt (no numpad flag, unlike the arrows). char-mods-keyCode.
    "0x5b-0x180000-0x21": {  # [
        "Action": 10, "Apply Mode": 0, "Escaping": 2, "Text": "[40~", "Version": 2,
    },
    "0x5d-0x180000-0x1e": {  # ]
        "Action": 10, "Apply Mode": 0, "Escaping": 2, "Text": "[41~", "Version": 2,
    },
}

# Default profile settings (applied to "New Bookmarks" array, first profile)
DEFAULT_PROFILE_SETTINGS = {
    # Font
    "Normal Font": "FiraCodeNFM-Light 13",
    "ASCII Ligatures": True,
    "ASCII Anti Aliased": True,

    # Terminal size
    "Columns": 80,
    "Rows": 25,
    "Scrollback Lines": 10000,
    "Unlimited Scrollback": False,
    "Character Encoding": 4,  # UTF-8

    # Behavior
    "Silence Bell": True,
    "Visual Bell": True,
    "Flashing Bell": False,
    "Mouse Reporting": True,
    "Cursor Type": 2,  # Underline cursor
    "Smart Cursor Color": True,

    # Option key behavior in profile
    "Option Key Sends": 2,  # Esc+

    # Semantic history: Open in Cursor editor
    "Semantic History": {
        "action": "best editor",
        # "editor": "com.github.atom",  # Required field, unused with command action
        # "text": "/opt/homebrew/bin/cursor -g \\1:\\2",
    },

    # Keyboard mappings for Option+Arrow word navigation
    # and Keychron Q1 Pro F17/F18/F19 remaps (right-cmd, fn+pgup, fn+pgdn)
    # routed to fixed CSI sequences so tmux user-keys match the same bytes
    # in both iTerm2 and Ghostty. F13–F16 skipped: macOS hijacks F14/F15
    # for brightness at the HID layer. Key format: char-modifiers-keyCode;
    # F-key modifier is 0x800000 (NSEventModifierFlagFunction).
    "Keyboard Map": {
        # Option+Left -> Esc+b (word back)
        "0xf702-0x280000-0x7b": {
            "Action": 10,  # Send escape sequence
            "Label": "",
            "Text": "b",
            "Version": 1,
        },
        # Option+Right -> Esc+f (word forward)
        "0xf703-0x280000-0x7c": {
            "Action": 10,
            "Label": "",
            "Text": "f",
            "Version": 1,
        },
        # F17 -> CSI 31~ (tmux secondary prefix via User0)
        "0xf714-0x800000-0x40": {
            "Action": 10,
            "Label": "",
            "Text": "[31~",
            "Version": 1,
        },
        # F18 -> CSI 32~ (tmux sesh picker via User1)
        "0xf715-0x800000-0x4f": {
            "Action": 10,
            "Label": "",
            "Text": "[32~",
            "Version": 1,
        },
        # F19 -> CSI 33~ (tmux User2, unbound for now)
        "0xf716-0x800000-0x50": {
            "Action": 10,
            "Label": "",
            "Text": "[33~",
            "Version": 1,
        },
    },
}


def deep_merge(base: dict, updates: dict) -> dict:
    """Recursively merge updates into base dict."""
    result = base.copy()
    for key, value in updates.items():
        if key in result and isinstance(result[key], dict) and isinstance(value, dict):
            result[key] = deep_merge(result[key], value)
        else:
            result[key] = value
    return result


def update_profile(profile: dict) -> dict:
    """Apply managed settings to a profile."""
    return deep_merge(profile, DEFAULT_PROFILE_SETTINGS)


def main():
    # Read existing plist from stdin (buffer into BytesIO for seekability)
    try:
        stdin_data = sys.stdin.buffer.read()
        if stdin_data:
            plist = plistlib.load(io.BytesIO(stdin_data))
        else:
            plist = {}
    except Exception as e:
        # If no existing file or invalid, start with empty dict
        sys.stderr.write(f"Warning: Could not read existing plist: {e}\n")
        plist = {}

    # Apply AI settings
    plist.update(AI_SETTINGS)

    # Apply global settings
    plist.update(GLOBAL_SETTINGS)

    # Apply global key bindings (merge into any existing GlobalKeyMap so other
    # user-defined global bindings are preserved; ours win on key collision)
    plist.setdefault("GlobalKeyMap", {})
    plist["GlobalKeyMap"].update(GLOBAL_KEYMAP)

    # Apply profile settings to the first profile (default)
    if "New Bookmarks" in plist and len(plist["New Bookmarks"]) > 0:
        plist["New Bookmarks"][0] = update_profile(plist["New Bookmarks"][0])
    else:
        # Create a minimal default profile if none exists
        plist["New Bookmarks"] = [DEFAULT_PROFILE_SETTINGS.copy()]

    # Write as binary plist to temp file, then convert to XML with plutil
    # This preserves macOS's native float formatting (avoids cosmetic diffs)
    with tempfile.NamedTemporaryFile(suffix='.plist', delete=False) as tmp:
        plistlib.dump(plist, tmp, fmt=plistlib.FMT_BINARY, sort_keys=True)
        tmp_path = tmp.name

    try:
        result = subprocess.run(
            ['plutil', '-convert', 'xml1', tmp_path, '-o', '-'],
            capture_output=True,
            check=True,
        )
        sys.stdout.buffer.write(result.stdout)
    finally:
        os.unlink(tmp_path)


if __name__ == "__main__":
    main()

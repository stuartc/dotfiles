#!/bin/bash
#
# Open or switch to the Workbook nvim in tmux, optionally sending it keys via
# its remote API.
#
# Usage:
#   workbook                                        # open/switch to Workbook
#   workbook '<C-\><C-n>:Workbook daily-log<CR>'    # open/switch + send keys

set -euo pipefail

if [ -z "${TMUX:-}" ]; then
  echo "Not in a tmux session" >&2
  exit 1
fi

SESSION="main"
WINDOW="Workbook"
TARGET="=$SESSION:=$WINDOW"
DIR=~/Documents/Workbook
SOCKET="/tmp/nvim-workbook.sock"
NVIM="nvim --listen $SOCKET"
NVIM_KEYS="${1:-}"

listening() { nvim --server "$SOCKET" --remote-expr 1 >/dev/null 2>&1; }

nvim_pane() {
  tmux list-panes -t "$TARGET" -F '#{pane_id} #{pane_current_command}' \
    | awk '$2 == "nvim" { print $1; exit }'
}

# nvim is always started as a pane's own command. Typing it into an existing
# pane races shell startup and lands in whatever else is running there.
launched=""
if ! tmux has-session -t "=$SESSION" 2>/dev/null; then
  rm -f "$SOCKET"
  tmux new-session -d -s "$SESSION" -n "$WINDOW" -c "$DIR" "$NVIM"
  launched=1
elif ! tmux list-windows -t "=$SESSION" -F '#W' | grep -Fxq "$WINDOW"; then
  rm -f "$SOCKET"
  tmux new-window -d -t "=$SESSION" -n "$WINDOW" -c "$DIR" "$NVIM" \; \
    move-window -s "$TARGET" -t "=$SESSION:0" \; \
    move-window -t "=$SESSION:" -r
  launched=1
elif [ -z "$(nvim_pane)" ]; then
  rm -f "$SOCKET"
  tmux split-window -d -b -h -t "$TARGET" -c "$DIR" "$NVIM"
  launched=1
fi

tmux set -t "$TARGET" -w automatic-rename off \; set -t "$TARGET" -w allow-rename off

PANE=$(nvim_pane)

if ! listening; then
  if [ -z "$launched" ]; then
    # nvim was started by hand without --listen; add the server in place.
    rm -f "$SOCKET"
    tmux send-keys -t "$PANE" 'C-\' C-n ":call serverstart('$SOCKET')" Enter
  fi
  for _ in $(seq 1 50); do
    listening && break
    sleep 0.1
  done
  if ! listening; then
    echo "workbook: timed out waiting for nvim socket $SOCKET" >&2
    exit 1
  fi
fi

tmux select-window -t "$TARGET" \; select-pane -t "$PANE"
if [ -n "$(tmux display-message -p '#{client_tty}')" ]; then
  tmux switch-client -t "=$SESSION"
fi

if [ -n "$NVIM_KEYS" ]; then
  nvim --server "$SOCKET" --remote-send "$NVIM_KEYS"
fi

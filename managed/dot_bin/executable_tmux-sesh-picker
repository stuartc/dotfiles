#!/usr/bin/env bash
# Sesh picker for the outer tmux. If invoked while tmux-suspend has the
# outer suspended and the session actually changes, auto-resumes so the
# new session is responsive without an extra F12.

set -euo pipefail

before_session=$(tmux display-message -p '#S')
was_suspended=0
if [[ "$(tmux display-message -p '#{client_key_table}')" == "suspended" ]]; then
  was_suspended=1
fi

selection=$(
  sesh list --icons | fzf --tmux 80%,70% --ansi --no-sort \
    --prompt '⚡  ' \
    --header '^a all  ^t tmux  ^g configs  ^x zoxide  ^d kill' \
    --preview 'sesh preview {}' --preview-window 'right:55%' \
    --bind 'tab:down,btab:up' \
    --bind 'ctrl-a:change-prompt(⚡  )+reload(sesh list --icons)' \
    --bind 'ctrl-t:change-prompt(🪟  )+reload(sesh list -t --icons)' \
    --bind 'ctrl-g:change-prompt(⚙️  )+reload(sesh list -c --icons)' \
    --bind 'ctrl-x:change-prompt(📁  )+reload(sesh list -z --icons)' \
    --bind 'ctrl-d:execute(tmux kill-session -t {2..})+change-prompt(⚡  )+reload(sesh list --icons)'
) || exit 0

[[ -z "$selection" ]] && exit 0

sesh connect "$selection"

after_session=$(tmux display-message -p '#S')
if [[ "$was_suspended" == 1 && "$before_session" != "$after_session" ]]; then
  "$HOME/.config/tmux/plugins/tpm/tmux-suspend/scripts/resume.sh" ""
fi

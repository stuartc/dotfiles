#! /usr/bin/env bash
set -e

HOSTNAME=$(hostname -s)
CONFIG_DIR="${RESTIC_CONFIG_DIR:-$HOME/.private/restic}"
PATHS_FILE="$CONFIG_DIR/paths"
EXCLUDES_FILE="$CONFIG_DIR/excludes"

# Parse arguments
EXPORT_ONLY=false
DRY_RUN=false
EXTRA_ARGS=()
for arg in "$@"; do
  case "$arg" in
    export)   EXPORT_ONLY=true ;;
    dry-run)  DRY_RUN=true ;;
    *)        EXTRA_ARGS+=("$arg") ;;
  esac
done

if [ "$EXPORT_ONLY" = false ]; then
  if [ ! -f "$PATHS_FILE" ]; then
    echo "Error: paths file not found at $PATHS_FILE"
    echo "Create it with one backup path per line (~ will be expanded)"
    exit 1
  fi
  if [ ! -f "$EXCLUDES_FILE" ]; then
    echo "Error: excludes file not found at $EXCLUDES_FILE"
    echo "Create it with one exclude pattern per line"
    exit 1
  fi
fi

export RESTIC_READ_CONCURRENCY=5
export RESTIC_PACK_SIZE=64

# Check if credentials are already available
if [ -n "$RESTIC_REPOSITORY" ] && [ -n "$RESTIC_PASSWORD" ]; then
  echo "RESTIC_REPOSITORY and RESTIC_PASSWORD already set, skipping credential retrieval from rbw"
else
  echo "Getting Backblaze B2 credentials..."
  source <(rbw get backblaze.com --raw |
    jq -r '.fields[] | "export \(.name)=\"\(.value)\""')
fi

# Check that RESTIC_[REPOSITORY|PASSWORD] and B2_ACCOUNT_[ID|KEY] are set
for var in RESTIC_REPOSITORY RESTIC_PASSWORD B2_ACCOUNT_ID B2_ACCOUNT_KEY; do
  eval "value=\$$var"
  if [ -z "$value" ]; then
    echo "Error: $var is not set"
    exit 1
  fi
done

if [ "$EXPORT_ONLY" = true ]; then
  echo "Environment variables exported. You can now use restic commands directly."
  echo "Note: You should source this script (e.g., 'source restic_backup export') for variables to persist in your shell."
  return 0 2>/dev/null || exit 0
fi

# Read paths from config, expanding ~ and skipping comments/blank lines
BACKUP_PATHS=()
while IFS= read -r line; do
  line="${line%%#*}"       # strip inline comments
  line="${line%"${line##*[![:space:]]}"}"  # trim trailing whitespace
  line="${line#"${line%%[![:space:]]*}"}"  # trim leading whitespace
  [ -z "$line" ] && continue
  BACKUP_PATHS+=("${line/#\~/$HOME}")
done < "$PATHS_FILE"

if [ ${#BACKUP_PATHS[@]} -eq 0 ]; then
  echo "Error: no paths found in $PATHS_FILE"
  exit 1
fi

DRY_RUN_ARGS=()
if [ "$DRY_RUN" = true ]; then
  DRY_RUN_ARGS+=(--dry-run -v)
fi

restic backup \
  -H "$HOSTNAME" \
  --exclude-file "$EXCLUDES_FILE" \
  --limit-upload 10000 \
  --compression max \
  "${DRY_RUN_ARGS[@]}" \
  "${BACKUP_PATHS[@]}" \
  "${EXTRA_ARGS[@]}"

#!/bin/zsh
#
# Open or switch to the Workbook window in tmux.
#
# If a window named "Workbook" already exists, switch to it.
# Otherwise, create a new window at position 1 with nvim.
#
# Usage:
#   workbook

if [[ -z "$TMUX" ]]; then
  echo "Not in a tmux session"
  return 1
fi

if tmux list-windows -F '#W' | grep -q '^Workbook$'; then
  tmux select-window -t 'Workbook'
else
  tmux new-window -n 'Workbook' -c ~/Documents/Workbook 'nvim' \; \
    move-window -t 0 \; \
    move-window -r \; \
    set -w automatic-rename off \; \
    set -w allow-rename off
fi

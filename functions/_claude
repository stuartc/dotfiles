#compdef claude

_claude() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Display help for command]' \
    '(-v --version)'{-v,--version}'[Output the version number]' \
    '*--add-dir[Additional directories to allow tool access to]:directory:_files -/' \
    '--advisor[Advisor model for the current session]:model:(fable opus sonnet)' \
    '--agent[Agent for the current session]:agent:' \
    '--agents[JSON object defining custom agents]:json:' \
    '--allow-dangerously-skip-permissions[Enable bypassing all permission checks as an option]' \
    '(--allowedTools --allowed-tools)'{--allowedTools,--allowed-tools}'[Comma or space-separated list of tool names to allow]:tools:' \
    '--append-system-prompt[Append a system prompt to the default system prompt]:prompt:' \
    '--autocompact[Auto-compact window size]:mode:(auto)' \
    '--ax-screen-reader[Render screen-reader friendly output]' \
    '--bare[Minimal mode: skip hooks, LSP, plugin sync, etc.]' \
    '*--betas[Beta headers to include in API requests]:beta:' \
    '--brief[Enable SendUserMessage tool for agent-to-user communication]' \
    '(--no-chrome)--chrome[Enable Claude in Chrome integration]' \
    '--cloud[Create a cloud session]::description/session_id/url:' \
    '(-c --continue)'{-c,--continue}'[Continue the most recent conversation in the current directory]' \
    '--dangerously-skip-permissions[Bypass all permission checks]' \
    '(-d --debug)'{-d,--debug}'[Enable debug mode with optional category filtering]::filter:' \
    '--debug-file[Write debug logs to a specific file path]:path:_files' \
    '--disable-slash-commands[Disable all skills]' \
    '(--disallowedTools --disallowed-tools)'{--disallowedTools,--disallowed-tools}'[Comma or space-separated list of tool names to deny]:tools:' \
    '--effort[Effort level for the current session]:level:(low medium high xhigh max)' \
    '--environment[Create a new cloud session on a self-hosted environment]:environment_id:' \
    '--exclude-dynamic-system-prompt-sections[Move per-machine sections out of the system prompt]' \
    '--fallback-model[Enable automatic fallback to specified model(s)]:model:' \
    '*--file[File resources to download at startup]:spec:' \
    '--fork-session[When resuming, create a new session ID instead of reusing the original]' \
    '--forward-subagent-text[Forward subagent text and thinking blocks]' \
    '--from-pr[Resume a session linked to a PR by PR number/URL]::pr:' \
    '--ide[Automatically connect to IDE on startup]' \
    '--include-hook-events[Include all hook lifecycle events in the output stream]' \
    '--include-partial-messages[Include partial message chunks as they arrive]' \
    '--input-format[Input format]:format:(text stream-json)' \
    '--json-schema[JSON Schema for structured output validation]:schema:' \
    '--max-budget-usd[Maximum dollar amount to spend on API calls]:amount:' \
    '*--mcp-config[Load MCP servers from JSON files or strings]:config:_files' \
    '--model[Model for the current session]:model:(fable opus sonnet)' \
    '(-n --name)'{-n,--name}'[Set a display name for this session]:name:' \
    '(--chrome)--no-chrome[Disable Claude in Chrome integration]' \
    '--no-session-persistence[Disable session persistence]' \
    '--output-format[Output format]:format:(text json stream-json)' \
    '--permission-mode[Permission mode]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)' \
    '--permission-prompts[Who answers permission prompts]:target:(host none)' \
    '*--plugin-dir[Load a plugin from a directory or .zip for this session only]:path:_files -g "*.zip"' \
    '*--plugin-url[Fetch a plugin .zip from a URL for this session only]:url:' \
    '(-p --print)'{-p,--print}'[Print response and exit]' \
    '--prompt-suggestions[Enable prompt suggestions]::value:' \
    '--remote-control[Start an interactive session with Remote Control enabled]::name:' \
    '--remote-control-session-name-prefix[Prefix for auto-generated Remote Control session names]:prefix:' \
    '--replay-user-messages[Re-emit user messages from stdin back on stdout]' \
    '--restricted[Restricted mode: removes tools that run commands or code]' \
    '(-r --resume)'{-r,--resume}'[Resume a conversation by session ID, or open interactive picker]::session:' \
    '--safe-mode[Start with all customizations disabled]' \
    '--session-id[Use a specific session ID for the conversation]:uuid:' \
    '--setting-sources[Comma-separated list of setting sources]:sources:(user project local)' \
    '--settings[Path to a settings JSON file or a JSON string]:file-or-json:_files' \
    '--strict-mcp-config[Only use MCP servers from --mcp-config]' \
    '--system-prompt[System prompt to use for the session]:prompt:' \
    '--system-prompt-snapshot[Record the system prompt once per conversation]:value:(on off)' \
    '--teleport[Resume a teleport session]::session:' \
    '--tmux[Create a tmux session for the worktree (requires --worktree)]' \
    '*--tools[Specify the list of available tools from the built-in set]:tool:' \
    '--verbose[Override verbose mode setting from config]' \
    '(-w --worktree)'{-w,--worktree}'[Create a new git worktree for this session]::name:' \
    '1: :->command' \
    '*:: :->args'

  case $state in
    (command)
      local -a commands
      commands=(
        'agents:Manage background agents'
        'attach:Open a background session in this terminal'
        'auth:Manage authentication'
        'auto-mode:Inspect or reset auto mode classifier configuration'
        'doctor:Check the health of your Claude Code installation'
        'gateway:Run the enterprise auth/telemetry gateway'
        'import:Import config from another AI coding agent'
        'install:Install Claude Code native build'
        'logs:Print a background session'\''s recent terminal output'
        'mcp:Configure and manage MCP servers'
        'plugin:Manage Claude Code plugins'
        'plugins:Manage Claude Code plugins'
        'project:Manage Claude Code project state'
        'respawn:Restart a background session, or all of them with --all'
        'rm:Delete a background session'
        'setup-token:Set up a long-lived authentication token'
        'stop:Stop a background session'
        'kill:Stop a background session'
        'ultrareview:Run a cloud-hosted multi-agent code review'
        'update:Check for updates and install if available'
        'upgrade:Check for updates and install if available'
      )
      _describe -t commands 'claude command' commands || _default
      ;;
    (args)
      curcontext="${curcontext%:*}-$words[1]:"
      case $words[1] in
        (auth) _claude_auth ;;
        (mcp) _claude_mcp ;;
        (plugin|plugins) _claude_plugin ;;
        (project) _claude_project ;;
        (install) _arguments '1:target:(stable latest)' ;;
        (attach|logs|rm|stop|kill)
          _message 'background session id'
          ;;
        (respawn)
          _arguments \
            '--all[Restart all background sessions]' \
            '1:background session id:'
          ;;
        (*) _default ;;
      esac
      ;;
  esac
}

_claude_auth() {
  local curcontext="$curcontext" state line

  _arguments -C \
    '1: :->subcommand' \
    '*:: :->args'

  case $state in
    (subcommand)
      local -a subcommands
      subcommands=(
        'help:Display help for command'
        'login:Sign in'
        'logout:Log out'
        'status:Show auth status'
      )
      _describe -t commands 'claude auth command' subcommands
      ;;
    (args)
      _default
      ;;
  esac
}

_claude_mcp() {
  local curcontext="$curcontext" state line

  _arguments -C \
    '1: :->subcommand' \
    '*:: :->args'

  case $state in
    (subcommand)
      local -a subcommands
      subcommands=(
        'add:Add an MCP server'
        'add-from-claude-desktop:Import MCP servers from Claude Desktop'
        'add-json:Add an MCP server from JSON'
        'get:Show details for an MCP server'
        'help:Display help for command'
        'list:List configured MCP servers'
        'login:Log in to an MCP server'
        'logout:Log out of an MCP server'
        'remove:Remove an MCP server'
        'reset-project-choices:Reset approved/rejected project MCP servers'
        'serve:Run an MCP server'
      )
      _describe -t commands 'claude mcp command' subcommands
      ;;
    (args)
      case $words[1] in
        (add) _arguments '1:name:' '2:command or url:' '*:args:_default' ;;
        (add-json) _arguments '1:name:' '2:json:' ;;
        (get|remove|login|logout) _arguments '1:server name:' ;;
        (*) _default ;;
      esac
      ;;
  esac
}

_claude_plugin() {
  local curcontext="$curcontext" state line

  _arguments -C \
    '1: :->subcommand' \
    '*:: :->args'

  case $state in
    (subcommand)
      local -a subcommands
      subcommands=(
        'details:Show details for a plugin'
        'disable:Disable a plugin'
        'enable:Enable a plugin'
        'eval:Run a plugin eval suite'
        'help:Display help for command'
        'init:Create a new plugin'
        'new:Create a new plugin'
        'install:Install a plugin'
        'i:Install a plugin'
        'list:List installed plugins'
        'marketplace:Manage plugin marketplaces'
        'prune:Remove unused plugins'
        'autoremove:Remove unused plugins'
        'tag:Manage plugin tags'
        'uninstall:Uninstall a plugin'
        'remove:Uninstall a plugin'
        'update:Update a plugin'
        'validate:Validate a plugin'
      )
      _describe -t commands 'claude plugin command' subcommands
      ;;
    (args)
      case $words[1] in
        (validate) _arguments '1:path:_files -/' ;;
        (init|new) _arguments '1:name:' ;;
        (details|disable|enable|install|i|uninstall|remove|update) _arguments '1:plugin:' ;;
        (*) _default ;;
      esac
      ;;
  esac
}

_claude_project() {
  local curcontext="$curcontext" state line

  _arguments -C \
    '1: :->subcommand' \
    '*:: :->args'

  case $state in
    (subcommand)
      local -a subcommands
      subcommands=(
        'help:Display help for command'
        'purge:Purge project state'
      )
      _describe -t commands 'claude project command' subcommands
      ;;
    (args)
      case $words[1] in
        (purge) _arguments '1:path:_files -/' ;;
        (*) _default ;;
      esac
      ;;
  esac
}

_claude "$@"
